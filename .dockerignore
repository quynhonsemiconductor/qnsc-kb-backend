# Secrets and local runtime state must never enter a deployable image.
.env
.env.*
.git
.gitignore
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# User data and operational artifacts are mounted at runtime or kept outside
# the image. Including them risks both secret disclosure and stale content.
storage/
connector_sources/
backups/
celerybeat-schedule

# Development-only files.
tests/
docs/
evaluation/
*.log

# Not read by anything inside a container. They changed on most commits, which invalidated the final
# `COPY . .` layer for no reason (only the layer, but that layer is the one that is pushed every build).
.github/
infra/
.dockerignore
Dockerfile
docker-compose*.yml
trivy.yaml
renovate.json
release-please-config.json
pytest.ini
.venv/
venv/
node_modules/
*.md
