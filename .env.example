# Copy to .env and generate the two secrets below. No third-party API key is needed to
# index and search: embeddings run locally. Everything else runs as-is.
#
#   cp .env.example .env
#   poetry install --with ml                           # the embedding model, ~2.3 GB
#   docker compose up -d db redis
#   python scripts/bootstrap_db_role.py                # creates the qnsc_app role
#   alembic -c migrations/alembic.ini upgrade head
#   uvicorn src.api.main:app --reload
#
# Startup creates the BOOTSTRAP_ADMIN_* account below if the database has no global
# administrator — there is no signup route, so log in with that.
#
# .env is gitignored and dockerignored. Never commit it, and never copy a deployed
# environment's values into it — develop's R2 credentials can write to the shared bucket.
#
# Every key below is a real Settings field (tests/unit/test_env_example.py enforces that
# the two lists match), so leaving one blank means the blank, not the default. Blank is
# only safe where the type is optional — the numeric keys carry their real defaults.

# ── API ───────────────────────────────────────────────────────────────────────
PROJECT_NAME="QNSC Knowledge Base"
API_V1_STR="/api/v1"
# REQUIRED for local work, and not merely conventional: the Settings default is
# `production`, so an unset ENVIRONMENT enforces externally supplied secrets, HTTPS
# origins and R2 storage, and the app refuses to start. That default is deliberate — a
# deployment that forgets this variable must fail closed, not boot with the committed
# development secrets below.
ENVIRONMENT="development"

# Generate BOTH, they must differ:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY signs tokens; DATA_ENCRYPTION_KEY encrypts stored connector credentials and
# the workspace LLM API key at rest, so one leaking must not expose the other. During a
# rotation, keep old encryption keys in PREVIOUS_DATA_ENCRYPTION_KEYS until everything is
# re-encrypted.
SECRET_KEY="generate-me"
DATA_ENCRYPTION_KEY="generate-me-different"
PREVIOUS_DATA_ENCRYPTION_KEYS=""
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# ── Database ──────────────────────────────────────────────────────────────────
# TWO URLs, matching how this deploys: the app connects as a least-privilege role, the
# migrations as the owner.
#
# Not ceremony. Row-level security is FORCEd on the tenant tables and a SUPERUSER bypasses
# it entirely, so running as `postgres` with ENABLE_RLS=true gives you the switch turned
# on and no policy ever applied — worse than off, because it looks like coverage.
DATABASE_URL="postgresql+asyncpg://qnsc_app:qnsc_app_local_password@localhost:5432/qnsc_kb"
MIGRATION_DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/qnsc_kb"

# APP_DATABASE_ROLE is read by the app and by migration 20260802_05 (whom to GRANT to).
# APP_DATABASE_USER is read by docker/init-db.sh, which Postgres runs as a container init
# hook. Two names, two consumers — keep them identical, and matching DATABASE_URL above.
APP_DATABASE_ROLE="qnsc_app"
APP_DATABASE_USER="qnsc_app"
APP_DATABASE_PASSWORD="qnsc_app_local_password"

# Connection PARTS — an alternative to the two URLs above, for a managed database whose
# rotatable credentials arrive as separate environment variables. Leave DATABASE_HOST
# empty locally and these do nothing. Where they are used, the URL above must be UNSET
# rather than blank: config.py only composes from parts when DATABASE_URL was never
# supplied, so a copied .env that still carries the localhost line keeps it.
DATABASE_HOST=""
DATABASE_PORT=5432
DATABASE_NAME="qnsc_kb"
DATABASE_USER=""
DATABASE_PASSWORD=""
MIGRATION_DATABASE_USER=""
MIGRATION_DATABASE_PASSWORD=""

# Leave both as they are. RLS on locally is how a policy violation shows up before it
# reaches an environment; AUTO_CREATE_SCHEMA would build tables from the models and never
# exercise the migrations, so a broken one is first discovered by CI.
ENABLE_RLS=true
AUTO_CREATE_SCHEMA=false

REDIS_URL="redis://localhost:6379/0"

# Inline runs ingestion inside the uploading request — fine for one process. Set "celery"
# and run `celery -A src.workers.celery_app worker` to exercise retries, the dead-letter
# path and beat schedules, which is what deployed environments use.
JOB_MODE="inline"
# How often the inline-mode outbox recovery loop retries failed/stale events.
OUTBOX_RECOVERY_INTERVAL_SECONDS=300

# ── Embeddings ────────────────────────────────────────────────────────────────
# Local and in-process: no key, and no document or query text leaves the deployment.
# It needs the optional `ml` dependency group — `poetry install --with ml` — and the
# first run downloads ~2.3 GB of weights. Without that group the API starts, serves
# /health, and raises on the first search.
#
# Defined ONCE. EMBEDDING_DIMENSION must agree with the model: config.py derives 1024
# from this name, and migration 20260912_77 sizes the pgvector column and HNSW index
# from it. Changing the model means a migration and re-embedding every chunk — a query
# and a chunk from different models are points in unrelated spaces.
# intfloat/multilingual-e5-large-instruct is the default: on VN-MTEB (arXiv 2507.21500)
# it scores 40.88 retrieval against multilingual-e5-small's 34.12, and the highest
# overall average of all 18 models the paper measured, ahead of every 7B model tested
# (see the long note on EMBEDDING_MODEL in src/core/config.py). It is an instruct-tuned
# retrieval model needing the fuller "Instruct: ...\nQuery: ..." prefix for queries and
# NO prefix for passages (applied in src/lib/embeddings/__init__.py) -- a different
# convention than base e5's plain query:/passage:. 1024-wide, unlike the previous
# e5-small's 384, so switching TO this model needs the ALTER-COLUMN migration template,
# not the same-width delete+re-embed one.
EMBEDDING_MODEL="intfloat/multilingual-e5-large-instruct"
EMBEDDING_VERSION="e5-large-instruct-v1"
EMBEDDING_DIMENSION=1024

# HOW the model runs, kept apart from WHICH model runs. "torch" is
# sentence-transformers and is what the stored corpus was embedded with; "onnx" runs
# the identical graph on onnxruntime, with no torch and no transformers, which is
# ~2 GB less in every image that embeds. Same vectors either way — the parity test in
# tests/unit/test_embedding_backends.py is what proves that for a given model.
EMBEDDING_RUNTIME="onnx"
# Where the baked ONNX export lives: model.onnx + tokenizer.json.
EMBEDDING_ONNX_DIR="/opt/embedding-onnx"
# MiniLM is MEAN-pooled; bge-* are CLS-pooled. An ONNX export does not carry the pooling
# config that sentence-transformers reads, so it is stated rather than inferred — the
# wrong choice yields valid vectors in the wrong space and degrades retrieval silently.
# Every e5 model to date (small, base, large, large-instruct) is also mean-pooled, so
# this value has survived every e5 swap so far -- confirmed for large-instruct against
# its own 1_Pooling/config.json, not just assumed to carry over.
EMBEDDING_ONNX_POOLING="mean"
# A 0.5 vCPU task oversubscribes itself with onnxruntime's default thread pool and
# spends longer scheduling than embedding.
EMBEDDING_ONNX_THREADS=1
# Must equal the model's effective max_seq_length (sentence_bert_config.json — 128 for
# MiniLM, 512 for every e5 model since, including large-instruct): a runtime that
# truncates earlier lands long inputs in a different space with no error. Per-model,
# like EMBEDDING_DIMENSION.
EMBEDDING_MAX_TOKENS=512
EMBEDDING_BATCH_SIZE=32
EMBEDDING_HTTP_MAX_ATTEMPTS=4
EMBEDDING_HTTP_BACKOFF_SECONDS=1.0

CHUNKING_VERSION="v3-contextual-headers"

# ── Generation ────────────────────────────────────────────────────────────────
# The chat provider, its model and its API key are administrator-managed and stored
# encrypted (Admin > AI provider). Environment provider keys are intentionally NOT a
# source — see tests/unit/test_llm_provider_source.py. The keys below are read only as
# defaults for that page and by scripts; an unconfigured workspace answers from the
# retrieval fallback, not from a key found in the environment.
LLM_PROVIDER=""
LLM_BASE_URL=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
GLM_API_KEY=""
LLM_MODEL="gemma-4-26b-a4b-it"
AI_RATE_LIMIT_PER_MINUTE=30

# Gemini is one of the four selectable chat providers (openai, glm, groq, gemini) and is
# no longer used for embeddings. Leave the key empty unless a workspace selects it.
GEMINI_API_KEY=""
# A floating `-latest` alias on purpose: pinned models get retired for new API keys.
# gemini-2.5-flash-lite and the rest of the 2.5 family now return 404 "no longer
# available to new users", which surfaces as broken answers rather than a startup error.
GEMINI_MODEL="gemini-flash-lite-latest"
GEMINI_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GEMINI_THINKING_LEVEL="minimal"
LLM_TIMEOUT_SECONDS="90"

# Keep false. True lets a global administrator point the workspace API key at an
# arbitrary public HTTPS endpoint.
LLM_ALLOW_CUSTOM_BASE_URL="false"

# ── Ingestion and formatting ──────────────────────────────────────────────────
RESTRUCTURE_ENABLED="true"
RESTRUCTURE_MODEL=""
RESTRUCTURE_MAX_CHARS="120000"
# Sections are formatted concurrently; see the note in config.py. Smaller is faster and
# choppier — the seams are where headings lose their thread.
RESTRUCTURE_SECTION_CHARS="8000"
RESTRUCTURE_MAX_CONCURRENCY="4"
RESTRUCTURE_MAX_OUTPUT_TOKENS=65536
RESTRUCTURE_TIMEOUT_SECONDS="300"
RESTRUCTURE_NUMERIC_COVERAGE_THRESHOLD="0.90"
PADDLEOCR_LANG="en"
MARKITDOWN_ENABLED="true"

# ── Retrieval ─────────────────────────────────────────────────────────────────
VECTOR_DISTANCE_THRESHOLD="0.45"
RAG_MIN_RELEVANCE_SCORE="0.12"
RAG_MIN_CONTEXT_SCORE="0.35"
RAG_LOW_CONFIDENCE_SCORE="0.5"
# Off by default: adds a real LLM call (per flagged cited sentence) to live /ai/ask
# latency, unlike the retrieval-side flags above.
CLAIM_VERIFICATION_ENABLED="false"
CLAIM_VERIFICATION_MAX_SENTENCES=5
# Each retrieval leg truncates here BEFORE RRF fusion, so it is a recall ceiling.
# Raising it to 256 only pays off with a retrieval-trained encoder — see the note on
# RAG_CANDIDATE_POOL_SIZE in src/core/config.py — and needs HNSW_EF_SEARCH ~400.
RAG_CANDIDATE_POOL_SIZE=240
# Must stay >= RAG_CANDIDATE_POOL_SIZE. pgvector's default is 40, below the pool we ask
# for, and it filters AFTER the index scan — measured on 0.8.6, a LIMIT 48 returned only
# 40 rows at the default. Valid range 1..1000; higher costs latency.
HNSW_EF_SEARCH=1000
RAG_RERANK_LIMIT=80
RAG_MAX_CONTEXT_PARENTS=40
RAG_CONTEXT_MAX_CHARS=70000
RAG_CONTEXT_MAX_TOKENS=17500
RAG_PARENT_CONTEXT_CHARS=2400
RAG_MAX_PARENTS_PER_ARTICLE=15
RAG_ENABLE_EXTENDED_SECTION="true"
RAG_CACHE_EXTENDED_SECTION="false"
# Off by default: a new code path with no production traffic behind it yet, and it needs
# the optional `ml` poetry group (sentence-transformers) installed to run at all.
CROSS_ENCODER_RERANKER_ENABLED="false"
CROSS_ENCODER_MODEL="BAAI/bge-reranker-v2-m3"
CROSS_ENCODER_CANDIDATE_POOL=30
# Off by default, same reasoning as CROSS_ENCODER_RERANKER_ENABLED above: a new
# retrieval leg (chunks from articles whose entity graph overlaps with entities named in
# the query) with no production traffic behind it yet.
GRAPH_RETRIEVAL_ENABLED="false"
GRAPH_RETRIEVAL_POOL_SIZE=30
# Off by default, same reasoning as CROSS_ENCODER_RERANKER_ENABLED/GRAPH_RETRIEVAL_ENABLED
# above: a new code path with no production traffic behind it yet, and this one adds a
# real LLM call to the live search path (rag/multi_query.py).
MULTI_QUERY_RETRIEVAL_ENABLED="false"
MULTI_QUERY_MAX_SUBQUERIES=3
MULTI_QUERY_MAX_FOLLOWUPS=1
CLARIFICATION_ON_AMBIGUOUS_DEPARTMENTS_ENABLED="false"
RAG_ALLOW_EXTENDED_ON_REFUSAL="false"
# Character budget for conversation history injected into the LLM prompt.
RAG_HISTORY_MAX_CHARS=9000
# Output cap for the main RAG generation path (cost/latency bound).
# Uncapped in code (None) so a reply is never cut off mid-word — see the note in
# config.py. Pydantic cannot read "no value" back into an optional int, so this file
# carries a number instead; it bounds LOCAL runs only. Deployed tasks set no RAG_* env
# vars at all and therefore run uncapped. Delete this line's value at your peril: an
# empty string fails validation at startup rather than meaning "unlimited".
RAG_MAX_ANSWER_TOKENS=32768
PROMPT_VERSION="v1.0"
RETRIEVAL_VERSION="v5-e5-large-instruct"
RERANKER_VERSION="v1.0-lexical"

# ── Identity ──────────────────────────────────────────────────────────────────
# Restrict who can be created. Empty accepts any domain, which under company-scoped RLS
# means an accidental second tenant.
ALLOWED_EMAIL_DOMAINS="qnsc.vn"
ALLOW_SELF_REGISTRATION=false
ENABLE_API_DOCS=true

# The first global administrator, created automatically on API startup when the
# deployment has none — a migrated database has no users and there is no signup route.
# Log in with these; it is created once and never re-created, so changing the password
# through the app sticks.
#
# The password below is a DEVELOPMENT default and is published in this repository.
# Production refuses to start with it: set your own, or BOOTSTRAP_ADMIN_ENABLED=false if
# the administrator is provisioned some other way.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL="admin@qnsc.vn"
BOOTSTRAP_ADMIN_NAME="Admin"
BOOTSTRAP_ADMIN_PASSWORD="Admin123@"

# Entra sign-in IS implemented — /api/v1/auth/entra/login and /entra/callback. It uses
# the MICROSOFT_* application registration below plus MICROSOFT_LOGIN_REDIRECT_URI (the
# AUTH callback, distinct from the connector OAuth one), and only turns on once those are
# set. A matching, unexpired admin invitation is required; the old domain-wide
# auto-provisioning path is disabled.
MICROSOFT_LOGIN_REDIRECT_URI=""
# Entra sign-in requires a matching, unexpired admin invitation. There is no
# domain-wide auto-provisioning.
ENTRA_AUTO_PROVISION_DOMAIN=""
# Mailbox that invitations and password resets are sent FROM, e.g. "no-reply@qnsc.vn".
# Empty is safe ONLY in development: get_email_sender() falls back to FakeEmailSender when
# ENVIRONMENT is development/dev/local/test AND this is unset, so mail is captured in memory
# instead of sent. Every deployed environment pins ENVIRONMENT=production, where that
# fallback does NOT apply and the Graph sender raises "MICROSOFT_GRAPH_SENDER is not
# configured" before any HTTP call -- queued invitations then retry every 30s forever and
# never arrive. Nothing in validate_production() catches this.
MICROSOFT_GRAPH_SENDER=""
MICROSOFT_GRAPH_SCOPE="https://graph.microsoft.com/.default"
# get_email_sender() (src/services/email.py) picks the transport by EMAIL_PROVIDER:
#   graph (default) -- Microsoft Graph, with the FakeEmailSender fallback described above
#   ses             -- AWS SES; requires MAIL_FROM_EMAIL and AWS credentials (boto3's
#                      normal chain: AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY env vars,
#                      ~/.aws, or an IAM role). Useful locally to actually receive
#                      invitation emails without an Entra app registration.
#   fake            -- always use the in-memory sender, regardless of environment
EMAIL_PROVIDER="graph"
MAIL_FROM_EMAIL=""
MAIL_FROM_NAME="QNSC Knowledge Base"
SYSTEM_DATA_OWNER_EMAIL=""
DEFAULT_LANGUAGE="vi"
REVIEW_SLA_DAYS=3

# Generic OIDC is reported by /api/v1/auth/oidc/config and nothing else consumes it —
# there is no authorize redirect and no callback for this path yet.
OIDC_ISSUER_URL=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI="http://localhost:5173/auth/callback"
OIDC_SCOPES="openid profile email"

# Development and UAT fixtures only. Keep the passwords out of committed files and set
# them in the invoking shell when running scripts/seed_data.py or scripts/run_uat.py.
SEED_COMPANY_DOMAIN="acme.test"
SEED_TEST_PASSWORD="set-explicitly-before-seeding"
UAT_TEST_PASSWORD="set-explicitly-before-running-UAT"

# ── Source storage ────────────────────────────────────────────────────────────
# "local" keeps uploads on disk under SOURCE_STORAGE_PATH — no cloud credentials needed.
# For the R2 path, set BACKEND to "r2" and use your OWN bucket, not a deployed one. Keep
# the bucket private; the app serves originals only after its authorization check and
# never returns object URLs.
SOURCE_STORAGE_BACKEND="local"
SOURCE_STORAGE_PATH="/app/storage/sources"
SOURCE_STORAGE_BUCKET=""
SOURCE_STORAGE_PREFIX="qnsc-sources"
SOURCE_ORPHAN_GRACE_HOURS=24
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Optional explicit Cloudflare R2 S3 endpoint, e.g.
# https://<account-id>.r2.cloudflarestorage.com; arbitrary S3 endpoints are rejected.
S3_ENDPOINT_URL=""
AWS_REGION=""

# ── Connectors (optional) ─────────────────────────────────────────────────────
# Leave empty and SharePoint/Drive stay dormant; everything else works.
#
# MICROSOFT_TENANT_ID: your tenant GUID, not "common". Use application mode for an
# unattended 24/7 worker; delegated mode remains available for interactive OAuth setup.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""
MICROSOFT_REDIRECT_URI="http://localhost:8000/api/v1/connectors/oauth/callback"
MICROSOFT_CONNECTOR_AUTH_MODE="delegated"
# MICROSOFT_GRAPH_SCOPE is declared once, in the Entra block above.
MICROSOFT_GRAPH_SUBSCRIPTION_MINUTES=1440
# Comma-separated Entra object IDs, one allowlist per Microsoft connector:
#   MICROSOFT_SHAREPOINT_SITE_IDS  -> the `sharepoint` connector's site scopes
#   MICROSOFT_ONEDRIVE_USER_IDS    -> the `onedrive` connector's per-user drives
# Required in application mode, where tenant-wide discovery is deliberately not
# attempted so Sites.Selected and a least-privilege OneDrive allowlist both work.
# In delegated mode an empty MICROSOFT_ONEDRIVE_USER_IDS falls back to the signed-in
# admin's own drive.
MICROSOFT_SHAREPOINT_SITE_IDS=""
MICROSOFT_ONEDRIVE_USER_IDS=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/connectors/oauth/callback"

# FACTORY RESET — erases EVERY table except users, roles, permissions, departments and
# SSO identity links, for EVERY tenant. There is no undo and no backup taken: knowledge,
# drafts, connector OAuth grants, audit history, feature flags and the LLM provider key
# are all destroyed, so sources must be reconnected and the API key re-entered afterwards.
#
# Leave DISABLED unless a reset is actually being performed, and switch it back off after.
# Both variables are required: the endpoint answers 404 while disabled, and 403 for any
# account outside the allowlist. They live here, not in the database, so a compromised
# admin session cannot grant itself this capability — and the API refuses to invite,
# create or rename an account into the allowlisted address for the same reason.
#
# FACTORY_RESET_ALLOWED_EMAILS is comma-separated and matched case-insensitively.
FACTORY_RESET_ENABLED=false
FACTORY_RESET_ALLOWED_EMAILS=""

# The API ORIGIN with NO path — connectors.py appends
# /api/v1/connectors/webhooks/<system> itself. Including the path here doubles it, and
# Graph POSTs a validation token to that URL while CREATING a subscription, so enabling
# update notifications fails outright. Empty disables webhook registration.
CONNECTOR_WEBHOOK_BASE_URL=""
CONNECTOR_SYNC_DISPATCH_INTERVAL_SECONDS=30
CONNECTOR_RECONCILE_INTERVAL_MINUTES=360
CONNECTOR_AUTO_PUBLISH_MODE="governed"

# Department routing asks the LLM first, then falls back to keyword ranking against each
# department's name and description. The fallback is not a degraded mode: it is what runs
# whenever no LLM provider is configured.
DEPARTMENT_ROUTING_LLM_ENABLED=true
# Short on purpose: this runs inside document ingest, once per document, and a slow
# provider must cost a suggestion rather than the import.
DEPARTMENT_ROUTING_LLM_TIMEOUT=20.0
# Builds the tenant knowledge graph (entities + relationships) from every published
# article; see domain/entity_extraction.py and domain/graph_service.py.
GRAPH_EXTRACTION_ENABLED=true
GRAPH_EXTRACTION_TIMEOUT_SECONDS=45.0

# The approval agent applies an administrator's written rule to pending drafts. A rule
# does nothing unless it was explicitly granted can_approve or can_reject; this switch
# stops the agent entirely without deleting anyone's rules.
APPROVAL_AGENT_ENABLED=true
APPROVAL_AGENT_TIMEOUT=30.0
APPROVAL_AGENT_BATCH_LIMIT=50
# Empty by default: an operator opt-in, not a judgment the code makes about which
# departments are sensitive. Comma-separated, e.g. "Legal,Finance,Human Resources".
APPROVAL_AGENT_HIGH_RISK_DEPARTMENTS=""
# How often beat's run-approval-agent task applies every company's active rules to its
# pending queue. Without this trigger a correctly-scoped, authorized rule still left
# every new draft in the human queue until somebody remembered to call
# POST /governance/approval-agent/run by hand.
APPROVAL_AGENT_RUN_INTERVAL_SECONDS=300
CONNECTOR_ROOT_PATH="/app/storage/connectors"

# ── Ingestion, retention and scanning limits ──────────────────────────────────
MAX_SOURCE_UPLOAD_BYTES=26214400
MAX_CONNECTOR_API_RESPONSE_BYTES=5242880
MAX_CONNECTOR_FILES=2000
MAX_SOURCE_PAGES=500
MAX_SOURCE_TEXT_CHARS=2000000
MAX_SOURCE_IMAGE_PIXELS=40000000
# Near-duplicate detection cost controls, not accuracy knobs: the comparison is O(n*m),
# so it reads a bounded prefix and only for the candidates cheap token overlap ranks
# highest. Raising either costs super-linearly more and does not move the score.
SIMILARITY_COMPARE_CHARS=2000
SIMILARITY_MAX_SEQUENCE_COMPARISONS=50
MAX_SOURCE_UNCOMPRESSED_BYTES=100000000
MAX_SOURCE_ARCHIVE_FILES=2000
METRICS_RETENTION_DAYS=30
MALWARE_SCAN_ENABLED="false"
MALWARE_SCANNER_COMMAND="clamdscan"
MALWARE_SCANNER_HOST=""
MALWARE_SCANNER_PORT=3310
OTEL_EXPORTER_OTLP_ENDPOINT=""

# ── Single-VPS deployment only (docker-compose.production.yml) ────────────────
# Ignore this block for local work. Use a long random value for each secret/password,
# and override CORS_ORIGINS and FRONTEND_URL with the deployed HTTPS origin.
PUBLIC_HOSTNAME="kb.example.com"
VITE_API_BASE_URL="/api/v1"
POSTGRES_ADMIN_USER="postgres"
POSTGRES_ADMIN_PASSWORD="replace-with-a-long-random-password"
POSTGRES_DB="qnsc_kb"
REDIS_PASSWORD="replace-with-a-long-random-password"
