{$PUBLIC_HOSTNAME} {
    encode gzip
    # The app enforces a 25 MB upload limit itself, but only after the body
    # has been streamed; reject oversized bodies at the edge instead.
    request_body {
        max_size 30MB
    }
    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # frame-src/worker-src carry blob: because the source viewer renders a fetched
        # document into an <iframe src="blob:…"> (frontend PdfViewer). Without them
        # default-src 'self' blocked it, so this CSP broke the viewer as shipped.
        Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; img-src 'self' data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-src 'self' blob:; worker-src 'self' blob:;"
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /health/* {
        reverse_proxy api:8000
    }
    handle {
        reverse_proxy frontend:80
    }
}
